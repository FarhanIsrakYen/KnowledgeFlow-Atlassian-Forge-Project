{
  "name": "knowledgeflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"static/knowledgeflow/src/**/*.{js,jsx}\" \"*.{json,yml}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"static/knowledgeflow/src/**/*.{js,jsx}\" \"*.{json,yml}\"",
    "build": "npm --prefix static/knowledgeflow run build",
    "check": "npm run format:check && npm run lint && npm run build"
  },
  "dependencies": {
    "@forge/api": "^8.0.5",
    "@forge/realtime": "^1.0.1",
    "@forge/resolver": "2.0.0",
    "@forge/sql": "^4.0.5"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6"
  }
}
